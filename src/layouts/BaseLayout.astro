---
import '@/styles/globals.css'
import '@fontsource/ibm-plex-sans/400.css'
import '@fontsource/ibm-plex-sans/500.css'
import '@fontsource/ibm-plex-sans/600.css'
import '@fontsource/ibm-plex-sans/700.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import { Header } from '@/components/ui/Header'
import { Footer } from '@/components/ui/Footer'
import JsonLd from '@/components/seo/JsonLd.astro'
import { DEFAULT_OG_IMAGE } from '@/lib/seo'
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_OWNER,
  SITE_TAGLINE,
  SITE_URL,
} from '@/lib/site'

interface Props {
  title?: string
  description?: string
  canonical?: string | null
  wide?: boolean
  ogImage?: string
  ogType?: 'website' | 'article'
  robots?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonical,
  wide = false,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  robots,
  jsonLd = null,
} = Astro.props

const pageTitle = title ? `${title} | ${SITE_OWNER}` : `${SITE_NAME} — ${SITE_TAGLINE}`
const canonicalUrl =
  canonical === null
    ? null
    : new URL(canonical ?? Astro.url.pathname, SITE_URL).toString()
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_URL).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eef1ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141814" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/og/default.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_OWNER} />
    {robots ? <meta name="robots" content={robots} /> : null}
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="text/plain" title="LLMs" href="/llms.txt" />
    {jsonLd ? <JsonLd data={jsonLd} /> : null}
    <script is:inline>
      ;(function () {
        try {
          var t = localStorage.getItem('theme')
          var d = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.classList.toggle('dark', d)
        } catch (e) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="site-shell">
      <div aria-hidden="true" class="site-bg">
        <div class="site-bg__mesh"></div>
        <div class="site-bg__noise"></div>
        <div class="site-bg__vignette"></div>
      </div>
      <Header client:load />
      <main id="content" class:list={[wide ? 'relative z-10 flex-1 py-8 md:py-12' : 'site-main']}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --font-plex-sans: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    --font-plex-mono: 'IBM Plex Mono', ui-monospace, monospace;
  }
</style>
