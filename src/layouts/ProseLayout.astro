---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  description?: string
  path: string
}

const { title, description, path } = Astro.props
---

<BaseLayout title={title} description={description} canonical={path}>
  <article class="mx-auto w-full max-w-5xl space-y-8">
    <h1 class="page-title">{title}</h1>
    <div class="prose-site">
      <slot />
    </div>
  </article>
</BaseLayout>
