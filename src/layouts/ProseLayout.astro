---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  description?: string
  path: string
  robots?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null
  ogType?: 'website' | 'article'
  eyebrow?: string
  heading?: string
}

const {
  title,
  description,
  path,
  robots,
  jsonLd = null,
  ogType = 'website',
  eyebrow,
  heading = title,
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  robots={robots}
  jsonLd={jsonLd}
  ogType={ogType}
>
  <article class="mx-auto w-full max-w-5xl space-y-8">
    <header class="space-y-3">
      {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
      <h1 class="page-title">{heading}</h1>
    </header>
    <div class="prose-site">
      <slot />
    </div>
  </article>
</BaseLayout>
