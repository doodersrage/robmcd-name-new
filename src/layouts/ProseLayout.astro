---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  description?: string
  path: string
  robots?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null
  ogType?: 'website' | 'article'
  eyebrow?: string
  heading?: string
  portraitSrc?: string
  portraitAlt?: string
  ogImage?: string
}

const {
  title,
  description,
  path,
  robots,
  jsonLd = null,
  ogType = 'website',
  eyebrow,
  heading = title,
  portraitSrc,
  portraitAlt = '',
  ogImage,
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonical={path}
  robots={robots}
  jsonLd={jsonLd}
  ogType={ogType}
  ogImage={ogImage}
>
  <article class="mx-auto w-full max-w-5xl space-y-8">
    <header
      class:list={[
        'space-y-3',
        portraitSrc && 'flex flex-col gap-6 sm:flex-row sm:items-end sm:gap-8',
      ]}
    >
      {
        portraitSrc ? (
          <img
            src={portraitSrc}
            alt={portraitAlt}
            width="400"
            height="400"
            class="h-36 w-36 shrink-0 rounded-sm border object-cover sm:h-44 sm:w-44"
            style="border-color: var(--line)"
            loading="eager"
            decoding="async"
          />
        ) : null
      }
      <div class="min-w-0 space-y-3">
        {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
        <h1 class="page-title">{heading}</h1>
      </div>
    </header>
    <div class="prose-site">
      <slot />
    </div>
  </article>
</BaseLayout>
