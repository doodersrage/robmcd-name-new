---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import Content from '@/content/pages/contact.mdx'
import { ContactForm } from '@/components/react/ContactForm'
import { personSchema } from '@/lib/seo'
import { SITE_URL } from '@/lib/site'

const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  import.meta.env.TURNSTILE_SITE_KEY ||
  ''

const description =
  'Message Robert McDowell about infrastructure, legacy modernization, LLM Prompt Studio, or ThermalTrace — form only, reply within a couple of days.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema(),
    {
      '@type': 'ContactPage',
      '@id': `${SITE_URL}/contact#page`,
      url: `${SITE_URL}/contact`,
      name: 'Contact',
      description,
      mainEntity: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        url: `${SITE_URL}/contact`,
        availableLanguage: 'English',
      },
    },
  ],
}
---

<BaseLayout title="Contact" description={description} canonical="/contact" jsonLd={jsonLd}>
  <article class="mx-auto w-full max-w-5xl space-y-10">
    <header class="space-y-4">
      <p class="eyebrow">Contact</p>
      <h1 class="page-title">Send a message</h1>
      <div class="prose-site max-w-2xl">
        <Content />
      </div>
    </header>

    <section class="space-y-4" aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading" class="text-xl font-semibold tracking-tight md:text-2xl">
        Your note
      </h2>
      {
        siteKey ? (
          <ContactForm client:load siteKey={siteKey} />
        ) : (
          <p class="max-w-xl text-base leading-relaxed text-[var(--muted)]">
            The contact form is temporarily unavailable (Turnstile is not configured). Please try again later.
          </p>
        )
      }
    </section>
  </article>
</BaseLayout>
