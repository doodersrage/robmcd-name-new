---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { getWorkBySlug, WORK_CASE_STUDIES } from '@/content/work/case-studies'
import { SITE_LINKS } from '@/lib/site'
import { softwareApplicationSchema, workCaseStudySchema } from '@/lib/seo'

export function getStaticPaths() {
  const aliases = [{ params: { slug: 'garage-temp' } }, { params: { slug: 'llm-prompt-studio' } }]
  return [
    ...WORK_CASE_STUDIES.map((study) => ({ params: { slug: study.slug } })),
    ...aliases,
  ]
}

const { slug } = Astro.params
const study = getWorkBySlug(slug!)
if (!study) {
  return Astro.redirect('/work/')
}

const isProbeHarbor = study.slug === 'probeharbor'
const isCastcut = study.slug === 'castcut'
const primaryHref = study.href ?? study.externalHref ?? SITE_LINKS.contact
const primaryExternal = Boolean(study.externalHref && !study.href)
const path = `/work/${study.slug}/`

const software = isProbeHarbor
  ? softwareApplicationSchema({
      name: 'ProbeHarbor',
      description: study.description,
      url: SITE_LINKS.probeHarbor,
      codeRepository: SITE_LINKS.probeHarborGithub,
      applicationCategory: 'UtilitiesApplication',
      offersUrl: SITE_LINKS.probeHarbor,
      sameAs: [
        SITE_LINKS.probeHarbor,
        SITE_LINKS.probeHarborGithub,
        SITE_LINKS.probeHarborDocs,
        path,
      ],
    })
  : isCastcut
    ? softwareApplicationSchema({
        name: 'Castcut',
        description: study.description,
        url: SITE_LINKS.castcut,
        codeRepository: SITE_LINKS.castcutGithub,
        applicationCategory: 'DeveloperApplication',
        offersUrl: SITE_LINKS.castcutGithub,
        sameAs: [SITE_LINKS.castcutGithub, SITE_LINKS.castcutDocs, SITE_LINKS.castcut],
      })
    : undefined

const jsonLd = workCaseStudySchema({
  title: study.title,
  description: study.description,
  path,
  software,
})
---

<BaseLayout
  title={`${study.title} case study`}
  description={study.description}
  canonical={path}
  ogType="article"
  ogImage={
    isCastcut
      ? '/work/prompt-studio/dashboard.jpg'
      : isProbeHarbor
        ? '/work/probeharbor/overview.jpg'
        : undefined
  }
  jsonLd={jsonLd}
>
  <section class="space-y-4">
    <p class="eyebrow">
      <a href="/work/" class="hover:underline">Work</a>
      <span class="mx-2 text-[var(--muted)]">/</span>
      {isProbeHarbor ? 'Product' : 'Case study'}
    </p>
    <h1 class="page-title">{study.title}</h1>
    <p class="font-mono text-sm text-[var(--muted)] md:text-base">{study.tagline}</p>
    <p class="max-w-3xl text-base leading-relaxed text-[var(--muted)]">{study.description}</p>
    <p class="font-mono text-xs text-[var(--muted)]">{study.stack.join(' · ')}</p>
    <div class="flex flex-wrap gap-3 pt-2">
      {
        primaryExternal ? (
          <a href={primaryHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            {study.linkLabel}
          </a>
        ) : (
          <a href={primaryHref} class="btn btn-primary">
            {study.linkLabel}
          </a>
        )
      }
      {
        study.href && study.externalHref && !isProbeHarbor ? (
          <a href={study.externalHref} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        ) : null
      }
      {
        isProbeHarbor ? (
          <>
            <a
              href={SITE_LINKS.probeHarborProtocol}
              class="btn btn-secondary"
            >
              Ingest protocol
            </a>
            <a href={SITE_LINKS.probeHarborForecastPage} class="btn btn-secondary">
              Pipe freeze forecast
            </a>
            <a href={SITE_LINKS.probeHarborIntegrationsPage} class="btn btn-secondary">
              Integrations
            </a>
            <a
              href={SITE_LINKS.probeHarborDemo}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Live demo
            </a>
            <a
              href={SITE_LINKS.probeHarborApps}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Companion apps
            </a>
            <a
              href={SITE_LINKS.probeHarborGuides}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Guides
            </a>
            <a
              href={SITE_LINKS.probeHarborGithub}
              class="btn btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </>
        ) : null
      }
    </div>
  </section>

  {
    isProbeHarbor ? (
      <>
        <figure class="mt-10 max-w-3xl space-y-3">
          <svg
            viewBox="0 0 640 160"
            class="w-full rounded-sm border bg-[var(--paper)]"
            style="border-color: var(--line)"
            role="img"
            aria-label="ProbeHarbor flow: sensors push or pull into Cloudflare ingest, dashboard and alerts, companion apps"
          >
            <rect x="8" y="48" width="120" height="64" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.35"></rect>
            <text x="68" y="78" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="currentColor">Sensors</text>
            <text x="68" y="96" text-anchor="middle" font-family="ui-sans-serif, sans-serif" font-size="11" fill="currentColor" opacity="0.65">ESP / Pico / HA</text>
            <path d="M136 80h48" stroke="currentColor" stroke-width="1.25" opacity="0.45"></path>
            <polygon points="184,80 176,76 176,84" fill="currentColor" opacity="0.45"></polygon>
            <rect x="192" y="48" width="140" height="64" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.35"></rect>
            <text x="262" y="78" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="currentColor">Ingest edge</text>
            <text x="262" y="96" text-anchor="middle" font-family="ui-sans-serif, sans-serif" font-size="11" fill="currentColor" opacity="0.65">Cloudflare Workers</text>
            <path d="M340 80h48" stroke="currentColor" stroke-width="1.25" opacity="0.45"></path>
            <polygon points="388,80 380,76 380,84" fill="currentColor" opacity="0.45"></polygon>
            <rect x="396" y="48" width="120" height="64" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.35"></rect>
            <text x="456" y="78" text-anchor="middle" font-family="ui-monospace, monospace" font-size="12" fill="currentColor">Dashboard</text>
            <text x="456" y="96" text-anchor="middle" font-family="ui-sans-serif, sans-serif" font-size="11" fill="currentColor" opacity="0.65">Alerts + history</text>
            <path d="M524 80h48" stroke="currentColor" stroke-width="1.25" opacity="0.45"></path>
            <polygon points="572,80 564,76 564,84" fill="currentColor" opacity="0.45"></polygon>
            <rect x="580" y="48" width="52" height="64" fill="none" stroke="currentColor" stroke-width="1.25" opacity="0.35"></rect>
            <text x="606" y="86" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="currentColor">Apps</text>
          </svg>
          <figcaption class="font-mono text-xs text-[var(--muted)]">
            Sensor → ingest → dashboard/alerts → companion apps (PWA, Desktop, Android, Bay Buddy).
          </figcaption>
        </figure>

        <section class="mt-10 space-y-6" aria-labelledby="probeharbor-shots">
          <div class="space-y-2">
            <h2 id="probeharbor-shots" class="text-xl font-semibold md:text-2xl">
              Product screens
            </h2>
            <p class="max-w-2xl text-base leading-relaxed text-[var(--muted)]">
              Overview, history, devices, and portfolio from the live dashboard.
            </p>
          </div>
          <ul class="space-y-8" role="list">
            <li>
              <figure class="space-y-3">
                <picture>
                  <source type="image/webp" srcset="/work/probeharbor/overview.webp 537w" sizes="(min-width: 768px) 768px, 100vw" />
                  <img
                    src="/work/probeharbor/overview.jpg"
                    alt="ProbeHarbor overview with space status, probe curves, freeze forecast, and regional comparison"
                    class="w-full max-w-3xl rounded-sm border"
                    style="border-color: var(--line)"
                    loading="lazy"
                    width="537"
                    height="1024"
                  />
                </picture>
                <figcaption class="font-mono text-xs text-[var(--muted)]">
                  Overview: live probes, time-to-freeze, flood status, claims pack.
                </figcaption>
              </figure>
            </li>
            <li>
              <figure class="space-y-3">
                <picture>
                  <source type="image/webp" srcset="/work/probeharbor/history-640.webp 640w, /work/probeharbor/history.webp 956w" sizes="(min-width: 768px) 768px, 100vw" />
                  <img
                    src="/work/probeharbor/history.jpg"
                    alt="ProbeHarbor reading history chart with temperature and humidity trends and freeze line"
                    class="w-full max-w-3xl rounded-sm border"
                    style="border-color: var(--line)"
                    loading="lazy"
                    width="956"
                    height="1024"
                  />
                </picture>
                <figcaption class="font-mono text-xs text-[var(--muted)]">
                  History: multi-probe trends, humidity, dew point, year compare.
                </figcaption>
              </figure>
            </li>
            <li>
              <figure class="space-y-3">
                <picture>
                  <source type="image/webp" srcset="/work/probeharbor/devices.webp 601w" sizes="(min-width: 768px) 768px, 100vw" />
                  <img
                    src="/work/probeharbor/devices.jpg"
                    alt="ProbeHarbor devices page showing garage pull feed, latest sensor values, and push device setup"
                    class="w-full max-w-3xl rounded-sm border"
                    style="border-color: var(--line)"
                    loading="lazy"
                    width="601"
                    height="1024"
                  />
                </picture>
                <figcaption class="font-mono text-xs text-[var(--muted)]">
                  Devices: push/pull ingest, ESP/Pico setup, live values.
                </figcaption>
              </figure>
            </li>
            <li>
              <figure class="space-y-3">
                <picture>
                  <source type="image/webp" srcset="/work/probeharbor/portfolio-640.webp 640w, /work/probeharbor/portfolio.webp 956w" sizes="(min-width: 768px) 768px, 100vw" />
                  <img
                    src="/work/probeharbor/portfolio.jpg"
                    alt="ProbeHarbor portfolio health across properties with freeze and flood risk scores"
                    class="w-full max-w-3xl rounded-sm border"
                    style="border-color: var(--line)"
                    loading="lazy"
                    width="956"
                    height="1024"
                  />
                </picture>
                <figcaption class="font-mono text-xs text-[var(--muted)]">
                  Portfolio: freeze and flood risk across properties.
                </figcaption>
              </figure>
            </li>
          </ul>
        </section>
      </>
    ) : null
  }

  {
    isCastcut ? (
      <section class="mt-10 space-y-6" aria-labelledby="prompt-studio-shots">
        <div class="space-y-2">
          <h2 id="prompt-studio-shots" class="text-xl font-semibold md:text-2xl">
            Product screens
          </h2>
          <p class="max-w-2xl text-base leading-relaxed text-[var(--muted)]">
            Dashboard, Generate, and Gallery from a running install.
          </p>
        </div>
        <ul class="space-y-8" role="list">
          <li>
            <figure class="space-y-3">
              <picture>
                <source type="image/webp" srcset="/work/prompt-studio/dashboard-640.webp 640w, /work/prompt-studio/dashboard.webp 1024w" sizes="(min-width: 768px) 768px, 100vw" />
                <img
                  src="/work/prompt-studio/dashboard.jpg"
                  alt="Castcut dashboard showing Play film loop, Studio shortcuts, and ComfyUI queue status"
                  class="w-full rounded-sm border"
                  style="border-color: var(--line)"
                  loading="lazy"
                  width="1024"
                  height="984"
                />
              </picture>
              <figcaption class="font-mono text-xs text-[var(--muted)]">
                Dashboard: Play film loop, shortcuts, ComfyUI queue.
              </figcaption>
            </figure>
          </li>
          <li>
            <figure class="space-y-3">
              <picture>
                <source type="image/webp" srcset="/work/prompt-studio/generate-640.webp 640w, /work/prompt-studio/generate.webp 1024w" sizes="(min-width: 768px) 768px, 100vw" />
                <img
                  src="/work/prompt-studio/generate.jpg"
                  alt="Castcut Generate tool with scene keywords, model picker, and detail controls"
                  class="w-full rounded-sm border"
                  style="border-color: var(--line)"
                  loading="lazy"
                  width="1024"
                  height="984"
                />
              </picture>
              <figcaption class="font-mono text-xs text-[var(--muted)]">
                Generate: keywords to model-aware prompts.
              </figcaption>
            </figure>
          </li>
          <li>
            <figure class="space-y-3">
              <picture>
                <source type="image/webp" srcset="/work/prompt-studio/gallery-640.webp 640w, /work/prompt-studio/gallery.webp 1024w" sizes="(min-width: 768px) 768px, 100vw" />
                <img
                  src="/work/prompt-studio/gallery.jpg"
                  alt="Castcut Gallery with search, filters, ratings, and review controls over thousands of outputs"
                  class="w-full rounded-sm border"
                  style="border-color: var(--line)"
                  loading="lazy"
                  width="1024"
                  height="618"
                />
              </picture>
              <figcaption class="font-mono text-xs text-[var(--muted)]">
                Gallery: search, rate, compare, export.
              </figcaption>
            </figure>
          </li>
        </ul>
      </section>
    ) : null
  }

  <div class="mt-12 space-y-10">
    {
      study.sections.map((section) => (
        <section class="space-y-3">
          <h2 class="text-xl font-semibold md:text-2xl">{section.heading}</h2>
          {section.body.map((para) => (
            <p class="max-w-3xl text-base leading-relaxed text-[var(--muted)]">{para}</p>
          ))}
          {section.links?.length ? (
            <ul class="mt-4 space-y-2 border-l pl-4" style="border-color: var(--line)">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm font-medium text-link"
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.label}
                  </a>
                  {link.note ? (
                    <span class="ml-2 font-mono text-xs text-[var(--muted)]">{link.note}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          ) : null}
        </section>
      ))
    }
  </div>

  <div class="mt-12 flex flex-wrap gap-3 border-t pt-10" style="border-color: var(--line)">
    <a href={SITE_LINKS.contact} class="btn btn-primary">Contact</a>
    <a href="/work/" class="btn btn-secondary">All case studies</a>
    {
      isProbeHarbor ? (
        <a href={SITE_LINKS.probeHarbor} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          Open probeharbor.dev
        </a>
      ) : null
    }
  </div>
</BaseLayout>
