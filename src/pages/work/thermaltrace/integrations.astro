---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { SITE_LINKS } from '@/lib/site'
import { breadcrumbSchema } from '@/lib/seo'

const integrations = [
  {
    title: 'Home Assistant (HACS)',
    body: 'Dual-run with local notify when you want LAN voice or phone alerts beside ThermalTrace channels.',
    href: SITE_LINKS.thermalTraceHomeAssistantGuide,
  },
  {
    title: 'Matter / Apple Home',
    body: 'Matterbridge plugin exposes share-link sensors to Apple Home, Google Home, and Alexa. Family live share works on Free.',
    href: SITE_LINKS.thermalTraceMatterGuide,
  },
  {
    title: 'SmartThings',
    body: 'Same Matter path into SmartThings, so a share link can show up as home devices.',
    href: SITE_LINKS.thermalTraceSmartThings,
  },
  {
    title: 'Node-RED',
    body: 'Flow the ingest and alert events into a LAN flow without standing up the dashboard yourself.',
    href: SITE_LINKS.thermalTraceNodeRed,
  },
  {
    title: 'InfluxDB & Telegraf',
    body: 'Ship readings into a time-series store you already graph.',
    href: SITE_LINKS.thermalTraceInflux,
  },
  {
    title: 'IFTTT, n8n & webhooks',
    body: 'Pro outbound webhooks for IFTTT, n8n, Sheets, and HMAC automation. Grafana and Prometheus metrics keys are on Pro.',
    href: SITE_LINKS.thermalTraceAutomation,
  },
]
---

<BaseLayout
  title="ThermalTrace integrations"
  description="Home Assistant, Matter, SmartThings, Node-RED, Influx, and webhook automations for ThermalTrace freeze and flood alerts."
  canonical={SITE_LINKS.thermalTraceIntegrationsPage}
  jsonLd={{
    '@context': 'https://schema.org',
    ...breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Work', path: '/work' },
      { name: 'ThermalTrace', path: SITE_LINKS.thermalTracePage },
      { name: 'Integrations', path: SITE_LINKS.thermalTraceIntegrationsPage },
    ]),
  }}
>
  <article class="space-y-10">
    <header class="space-y-3">
      <p class="eyebrow">ThermalTrace · kit</p>
      <h1 class="page-title">Integrations</h1>
      <p class="max-w-2xl text-base leading-relaxed text-[var(--muted)]">
        ThermalTrace keeps the hosted history and household alerts. These hooks are how that account meets a stack you
        already run. Step-by-step guides stay on thermaltrace.dev; this page is the map.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href={SITE_LINKS.thermalTraceIntegrations} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Guides on thermaltrace.dev
        </a>
        <a href={SITE_LINKS.thermalTraceDocs} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          Developer docs
        </a>
      </div>
    </header>

    <ol class="divide-y border-t" style="border-color: var(--line)">
      {
        integrations.map((item, index) => (
          <li class="grid gap-2 py-6 sm:grid-cols-[2rem_1fr] sm:gap-4">
            <span class="font-mono text-sm text-[var(--muted)]">{String(index + 1).padStart(2, '0')}</span>
            <div class="space-y-2">
              <a href={item.href} class="text-link text-lg font-semibold" target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
              <p class="max-w-2xl text-sm leading-relaxed text-[var(--muted)]">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold">Also on the product</h2>
      <p class="max-w-2xl text-sm leading-relaxed text-[var(--muted)]">
        MQTT can stay on the LAN through the bridge. Nest and Ecobee (Pro) add outdoor context. ESPHome, Shelly,
        Ambient, and WeatherFlow are pull or push paths on the same devices page. Source for the HACS integration and
        the Matter bridge is on GitHub.
      </p>
      <ul class="max-w-2xl space-y-2 border-l pl-4" style="border-color: var(--line)">
        <li>
          <a href={SITE_LINKS.thermalTraceHomeAssistant} class="text-sm font-medium text-link" target="_blank" rel="noopener noreferrer">
            Home Assistant HACS
          </a>
        </li>
        <li>
          <a href={SITE_LINKS.thermalTraceMatter} class="text-sm font-medium text-link" target="_blank" rel="noopener noreferrer">
            Matter bridge
          </a>
        </li>
      </ul>
    </section>

    <section class="space-y-4 border-t pt-8" style="border-color: var(--line)">
      <h2 class="text-xl font-semibold">Related</h2>
      <div class="flex flex-wrap gap-3">
        <a href={SITE_LINKS.thermalTracePage} class="btn btn-secondary">Case study</a>
        <a href={SITE_LINKS.thermalTraceProtocol} class="btn btn-secondary">Ingest protocol</a>
        <a href={SITE_LINKS.thermalTraceForecastPage} class="btn btn-secondary">Pipe freeze forecast</a>
      </div>
    </section>
  </article>
</BaseLayout>
