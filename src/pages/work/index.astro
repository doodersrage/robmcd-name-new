---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { WORK_CASE_STUDIES } from '@/content/work/case-studies'
import { itemListSchema } from '@/lib/seo'

const description =
  'Case studies — LLM Prompt Studio, ThermalTrace freeze and flood monitoring, and legacy stack modernization.'

const jsonLd = itemListSchema(
  'Work',
  description,
  WORK_CASE_STUDIES.map((study) => ({
    name: study.title,
    path: `/work/${study.slug}`,
    description: study.description,
  })),
)
---

<BaseLayout title="Work" description={description} canonical="/work" jsonLd={jsonLd}>
  <section class="space-y-8">
    <div class="space-y-3">
      <p class="eyebrow">Portfolio</p>
      <h1 class="page-title">Work</h1>
      <p class="max-w-2xl text-base leading-relaxed text-[var(--muted)]">
        Selected products and consulting patterns — problem, stack, and outcome.
      </p>
    </div>

    <ul class="divide-y" style="border-color: var(--line)">
      {
        WORK_CASE_STUDIES.map((study) => (
          <li class="py-8 first:pt-0">
            <h2 class="text-xl font-semibold">
              <a href={`/work/${study.slug}`} class="hover:underline">
                {study.title}
              </a>
            </h2>
            <p class="mt-1 font-mono text-sm text-[var(--muted)]">{study.tagline}</p>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-[var(--muted)]">{study.description}</p>
            <a href={`/work/${study.slug}`} class="mt-5 inline-flex text-sm font-medium text-link">
              Read case study
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
