---
export const prerender = true

import ProseLayout from '@/layouts/ProseLayout.astro'
import Content from '@/content/pages/homelab.mdx'
import { breadcrumbSchema } from '@/lib/seo'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Homelab', path: '/homelab' },
    ]),
  ],
}
---

<ProseLayout
  title="Homelab"
  description="Homelab endpoints on robmcd.name — AudioBookShelf, Shelf, Castcut, Jellyfin, Seer, Plex, and Romm for personal media, reachable from the public status board."
  path="/homelab"
  jsonLd={jsonLd}
>
  <Content />
</ProseLayout>
