---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DocPageView } from '@/components/comfyui-prompt-studio/DocPageView'
import { getPageBySlug, slugToPath } from '@/content/comfyui-prompt-studio/pages'
import { plainText } from '@/content/comfyui-prompt-studio/helpers'
import { breadcrumbSchema, personSchema, softwareSourceCodeSchema, techArticleSchema } from '@/lib/seo'
import { gitDates } from '@/lib/git-dates'
import { SITE_LINKS, absolutePageUrl } from '@/lib/site'

const page = getPageBySlug([])
if (!page) {
  throw new Error('Missing Castcut hub page')
}
const currentPath = slugToPath([])

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema(),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Castcut', path: currentPath },
    ]),
    {
      ...softwareSourceCodeSchema({
        name: 'Castcut',
        description: plainText(page.description),
        url: currentPath,
        codeRepository: SITE_LINKS.castcutGithub,
        sameAs: [SITE_LINKS.castcutGithub, SITE_LINKS.castcutDocs],
      }),
      '@id': `${absolutePageUrl(currentPath)}#software`,
    },
    {
      ...techArticleSchema({
        title: 'Castcut docs',
        description: plainText(page.description),
        path: currentPath,
        ...gitDates('src/content/comfyui-prompt-studio/sections/hub.ts'),
      }),
      about: { '@id': `${absolutePageUrl(currentPath)}#software` },
    },
  ],
}
---

<BaseLayout
  title="Castcut docs"
  description={plainText(page.description)}
  canonical={currentPath}
  wide
  jsonLd={jsonLd}
>
  <div class="site-main !max-w-6xl">
    <DocPageView client:load page={page} currentPath={currentPath} />
  </div>
</BaseLayout>
