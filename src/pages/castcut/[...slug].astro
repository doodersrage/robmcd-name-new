---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DocPageView } from '@/components/comfyui-prompt-studio/DocPageView'
import { DOC_PAGES, getPageBySlug, slugToPath } from '@/content/comfyui-prompt-studio/pages'
import { plainText } from '@/content/comfyui-prompt-studio/helpers'
import { breadcrumbSchema, techArticleSchema } from '@/lib/seo'
import { gitDates } from '@/lib/git-dates'

export function getStaticPaths() {
  return DOC_PAGES.filter((p) => p.slug.length > 0).map((page) => ({
    params: { slug: page.slug.join('/') },
  }))
}

const slugParam = Astro.params.slug
const slug = slugParam ? slugParam.split('/').filter(Boolean) : []
const page = getPageBySlug(slug)

if (!page) {
  return Astro.redirect('/castcut/')
}

const currentPath = slugToPath(page.slug)
const isMarketing = page.layout === 'marketing'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Castcut', path: '/castcut' },
      { name: page.title, path: currentPath },
    ]),
    techArticleSchema({
      title: page.title,
      description: plainText(page.description),
      path: currentPath,
      ...gitDates(`src/content/comfyui-prompt-studio/sections/${page.slug[0]}.ts`),
    }),
  ],
}
---

<BaseLayout
  title={page.title}
  description={plainText(page.description)}
  canonical={currentPath}
  wide
  ogType="article"
  jsonLd={jsonLd}
>
  <div class:list={[isMarketing ? 'site-main' : 'relative z-10 mx-auto w-full max-w-6xl flex-1 px-0 py-8 md:py-12']}>
    <DocPageView client:load page={page} currentPath={currentPath} />
  </div>
</BaseLayout>
