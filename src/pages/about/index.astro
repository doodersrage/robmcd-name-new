---
export const prerender = true

import ProseLayout from '@/layouts/ProseLayout.astro'
import Content from '@/content/pages/about.mdx'
import { aboutPageSchema } from '@/lib/seo'

const faqs = [
  {
    question: 'What kind of work do you take on?',
    answer:
      'Legacy repair and modernization, Linux/Windows server maintenance, MySQL/MSSQL administration, technical audits, SEO and AEO from the engineering side (Google Analytics certified; experience working with SEO companies), and product work like Prompt Studio or ThermalTrace when that fits.',
  },
  {
    question: 'Do you do SEO as a standalone service?',
    answer:
      'Not as a pure SEO agency. I implement and advise on structure, performance, analytics, schema, and content that search and answer engines can use, including alongside an SEO partner.',
  },
  {
    question: 'Do you only do greenfield builds?',
    answer:
      'No. Most useful work starts with what’s already running. Greenfield only when the old stack really can’t carry another year.',
  },
  {
    question: 'What is LLM Prompt Studio?',
    answer:
      'An MIT-licensed Next.js studio for ComfyUI and cloud stills/clips. Docs live at robmcd.name/llm-prompt-studio.',
  },
  {
    question: 'What is ThermalTrace?',
    answer:
      'Garage and workshop freeze/flood monitoring with ESP32/Pico ingest, alerts, and companion apps. Product at thermaltrace.dev; write-up at robmcd.name/work/thermaltrace.',
  },
  {
    question: 'Where should I start?',
    answer:
      'Use the contact form at robmcd.name/contact. Include stack, constraints, timeline, and what done looks like. Replies usually within a couple of days.',
  },
]

const description =
  'Robert McDowell, full-stack engineer since 2006. Legacy modernization, servers and databases, SEO/AEO, LLM Prompt Studio, and ThermalTrace.'
---

<ProseLayout
  title="About"
  heading="Robert McDowell"
  eyebrow="About"
  description={description}
  path="/about"
  portraitSrc="/about/robert-mcdowell.jpg"
  portraitAlt="Robert McDowell"
  ogImage="/about/robert-mcdowell.jpg"
  jsonLd={aboutPageSchema(faqs)}
>
  <Content />
</ProseLayout>
