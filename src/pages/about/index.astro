---
export const prerender = true

import ProseLayout from '@/layouts/ProseLayout.astro'
import Content from '@/content/pages/about.mdx'
import { aboutPageSchema } from '@/lib/seo'
import { VERSIONS } from '@/lib/versions'

const faqs = [
  {
    question: 'What kind of work do you take on?',
    answer:
      'Legacy repair and modernization, Linux/Windows server maintenance, MySQL/MSSQL administration, technical audits, SEO and AEO from the engineering side (Google Analytics certified; experience working with SEO companies), and product work like Castcut or ProbeHarbor when that fits.',
  },
  {
    question: 'Do you do SEO as a standalone service?',
    answer:
      'Not as a pure SEO agency. I implement and advise on structure, performance, analytics, schema, and content that search and answer engines can use, including alongside an SEO partner.',
  },
  {
    question: 'Do you only do greenfield builds?',
    answer:
      'No. Most useful work starts with what’s already running. Greenfield only when the old stack really can’t carry another year.',
  },
  {
    question: 'What is Castcut?',
    answer:
      `Local AI character filmmaking with ComfyUI: Cast → Outfit → Day → Scene → Cut film. Castcut ${VERSIONS.castcut} takes a screenplay through Scenes and a storyboard to a cut, with talking clips, narration, a score, finishing tools, and export to an editor. The classic tools it started with now ship separately as Prompt Studio. Docs at robmcd.name/castcut.`,
  },
  {
    question: 'What is ProbeHarbor?',
    answer:
      'Garage and workshop freeze, heat, and flood monitoring (formerly ThermalTrace) with ESP32/Pico ingest, alerts, a public pipe-freeze forecast, companion apps, and Matter, Home Assistant, and Node-RED. Product at probeharbor.dev; write-up at robmcd.name/work/probeharbor.',
  },
  {
    question: 'What is Shelf?',
    answer:
      'A self-hosted library for a household’s books, e-books, and audiobooks on .NET 10, with lending between readers, Kobo and KOReader sync, and books found and fetched for you. Write-up at robmcd.name/work/shelf; docs at doodersrage.github.io/shelf.',
  },
  {
    question: 'Where should I start?',
    answer:
      'Use the contact form at robmcd.name/contact. Include stack, constraints, timeline, and what done looks like. Replies usually within a couple of days.',
  },
]

const description =
  'Robert McDowell, full-stack engineer since 2006. Legacy modernization, servers and databases, SEO/AEO, Castcut, and ProbeHarbor.'
---

<ProseLayout
  title="About"
  heading="Robert McDowell"
  eyebrow="About"
  description={description}
  path="/about"
  portraitSrc="/about/robert-mcdowell.jpg"
  portraitAlt="Robert McDowell"
  ogImage="/about/robert-mcdowell.jpg"
  jsonLd={aboutPageSchema(faqs)}
>
  <Content />
</ProseLayout>
