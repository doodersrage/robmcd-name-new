---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { JsonRedactor } from '@/components/tools/JsonRedactor'
import { breadcrumbSchema } from '@/lib/seo'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Tools', path: '/tools' },
      { name: 'Log / JSON redactor', path: '/tools/redactor' },
    ]),
  ],
}
---

<BaseLayout
  title="Log / JSON redactor"
  description="Browser-only redactor for emails, JWTs, Bearer tokens, and common secret shapes — nothing leaves your machine; paste logs or JSON safely."
  canonical="/tools/redactor"
  jsonLd={jsonLd}
>
  <div class="space-y-8">
    <header class="space-y-3">
      <p class="eyebrow">Tools</p>
      <h1 class="page-title">Log / JSON redactor</h1>
      <p class="max-w-2xl text-base leading-relaxed text-[var(--muted)]">
        Paste a log or payload, copy a safer version. Nothing leaves the browser.
      </p>
    </header>
    <JsonRedactor client:load />
  </div>
</BaseLayout>
