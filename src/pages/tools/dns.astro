---
export const prerender = true

import BaseLayout from '@/layouts/BaseLayout.astro'
import { DnsTlsChecker } from '@/components/tools/DnsTlsChecker'
import { breadcrumbSchema } from '@/lib/seo'

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Tools', path: '/tools' },
      { name: 'DNS / HTTPS check', path: '/tools/dns' },
    ]),
  ],
}
---

<BaseLayout
  title="DNS / HTTPS check"
  description="Look up A/AAAA/MX/TXT records and probe HTTPS reachability from robmcd.name’s edge Worker — quick DNS and TLS sanity checks."
  canonical="/tools/dns"
  jsonLd={jsonLd}
>
  <div class="space-y-8">
    <header class="space-y-3">
      <p class="eyebrow">Tools</p>
      <h1 class="page-title">DNS / HTTPS check</h1>
      <p class="max-w-2xl text-base leading-relaxed text-[var(--muted)]">
        Quick shop check for a hostname — not a replacement for dig + openssl s_client when you need depth.
      </p>
    </header>
    <DnsTlsChecker client:load />
  </div>
</BaseLayout>
