---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { searchLocalContent } from '@/lib/search'

export const prerender = false

const query = Astro.url.searchParams.get('query') ?? ''
const hits = searchLocalContent(query)
---

<BaseLayout
  title={query ? `Search results for ${query}` : 'Search'}
  description="Search pages, notes, case studies, Prompt Studio docs, tools, and ThermalTrace topics on robmcd.name."
  canonical="/search"
  robots="noindex, follow"
>
  <div class="space-y-8">
    <h1 class="page-title">
      {query ? `Search Results for "${query}"` : 'Search'}
    </h1>

    <form action="/search" method="get" class="max-w-md">
      <label for="search-query" class="form-label">Query</label>
      <input id="search-query" name="query" type="search" class="input-field" value={query} />
    </form>

    {
      query ? (
        hits.length === 0 ? (
          <p class="text-[var(--muted)]">No results.</p>
        ) : (
          <ul class="divide-y" style="border-color: var(--line)">
            {hits.map((hit) => (
              <li class="py-6 first:pt-0">
                <p class="font-mono text-xs text-[var(--muted)]">{hit.source}</p>
                <a href={hit.href} class="mt-1 block text-lg font-semibold text-link">
                  {hit.title}
                </a>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--muted)]">{hit.description}</p>
              </li>
            ))}
          </ul>
        )
      ) : (
        <p class="text-[var(--muted)]">
          Search notes, hire/tools pages, case studies, Prompt Studio docs, and ThermalTrace keywords.
        </p>
      )
    }
  </div>
</BaseLayout>
