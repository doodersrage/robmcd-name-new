# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/)
# Test keys always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Never commit real keys. Local .env is gitignored; production uses Wrangler secrets.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP (contact + triage forms)
# Put EMAIL_* / SMTP_* / CONTACT_TO in Wrangler secrets for production — not in the Workers dashboard as plain env if you can avoid it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
SMTP_MAIL_FROM=
CONTACT_TO=

# Optional Cloudflare Web Analytics beacon token (omit to leave beacon off)
# PUBLIC_CF_WEB_ANALYTICS_TOKEN=
